#!/usr/bin/env bash
#
# Munin plugin: container memory usage from cgroup v2.
#
# Place this file in the munin plugin library (e.g., /usr/share/munin/plugins)
# and symlink it into /etc/munin/plugins as "memory".
#
# Reports anon, file cache, shmem, and kernel memory for this container from
# /sys/fs/cgroup/memory.stat. Swap is included when memory.swap.current is
# available. Upper limit is taken from memory.max when a limit is configured.
#
# A second graph (multigraph memory_workingset) reports page-cache working-set
# thrashing -- refaults and major faults -- from the same memory.stat, emitted
# only when the kernel exports the fields. See the workingset graph_info.

MEM_STAT=/sys/fs/cgroup/memory.stat
MEM_CURRENT=/sys/fs/cgroup/memory.current
MEM_MAX=/sys/fs/cgroup/memory.max
SWAP_CURRENT=/sys/fs/cgroup/memory.swap.current

if [[ "$1" = "autoconf" ]]; then
    if [[ -r "$MEM_STAT" && -r "$MEM_CURRENT" ]]; then
        echo yes
    else
        echo "no (${MEM_STAT} or ${MEM_CURRENT} not readable)"
    fi
    exit 0
fi

mem_max=$(cat "$MEM_MAX" 2>/dev/null)
have_swap=0
swap_current=
if [[ -r "$SWAP_CURRENT" ]]; then
    have_swap=1
    swap_current=$(cat "$SWAP_CURRENT")
fi

# Probe the working-set thrash fields. Field names differ by kernel:
# workingset_refault_file since ~5.9, bare workingset_refault before the
# file/anon split (effectively file refaults either way). pgmajfault is
# essentially always present. A single stable munin field "refault" is fed from
# whichever cgroup field exists, so the graph's field names do not change across
# kernels. The graph is emitted only when at least one field is present.
refault_field=""
have_majfault=0
if [[ -r "$MEM_STAT" ]]; then
    have_ws_file=0 have_ws_legacy=0
    while read -r key _; do
        case "$key" in
            workingset_refault_file) have_ws_file=1 ;;
            workingset_refault)      have_ws_legacy=1 ;;
            pgmajfault)              have_majfault=1 ;;
        esac
    done < "$MEM_STAT"
    if   (( have_ws_file ));   then refault_field=workingset_refault_file
    elif (( have_ws_legacy )); then refault_field=workingset_refault
    fi
fi
emit_ws=0
[[ -n "$refault_field" || "$have_majfault" -eq 1 ]] && emit_ws=1

if [[ "$1" = "config" ]]; then
{
    echo 'multigraph memory'
    echo 'graph_title Memory usage'
    if [[ "$mem_max" != "max" && -n "$mem_max" ]]; then
        echo "graph_args --base 1024 -l 0 --upper-limit ${mem_max}"
    else
        echo 'graph_args --base 1024 -l 0'
    fi
    echo 'graph_vlabel Bytes'
    echo 'graph_category system'
    echo 'graph_info Memory used by this container (cgroup v2). kernel includes slab, stacks, page tables, and other kernel overhead.'
    order="anon cache shmem kernel"
    [[ $have_swap -eq 1 ]] && order="$order swap"
    echo "graph_order $order"
    echo 'anon.label anon'
    echo 'anon.draw AREA'
    echo 'anon.info Anonymous memory (process heap and stack).'
    echo 'cache.label cache'
    echo 'cache.draw STACK'
    echo 'cache.info File page cache.'
    echo 'shmem.label shmem'
    echo 'shmem.draw STACK'
    echo 'shmem.info Shared memory and tmpfs.'
    echo 'kernel.label kernel'
    echo 'kernel.draw STACK'
    echo 'kernel.info Kernel memory (slab, stacks, page tables, etc.).'
    if [[ $have_swap -eq 1 ]]; then
        echo 'swap.label swap'
        echo 'swap.draw STACK'
        echo 'swap.info Swap space used.'
    fi

    if [[ $emit_ws -eq 1 ]]; then
        echo 'multigraph memory_workingset'
        echo 'graph_title Memory working set thrashing'
        echo 'graph_vlabel events per second'
        echo 'graph_category system'
        echo 'graph_info Page-cache working-set thrashing for this container (cgroup v2). "file-cache refaults" counts pages that were cached, evicted under memory pressure, then needed again and reread from disk -- a direct measure of the working set not fitting in RAM. "major page faults" is the coarser companion (it also counts cold first reads). For Overpass the page cache holds database blocks, so a rising refault rate is the DB working set outgrowing RAM: read it against the interpreter block-reads-per-query graph -- block reads per query rising with refaults flat means bigger queries, refaults rising means cache thrash. Omitted where the kernel does not export workingset accounting.'
        if [[ -n "$refault_field" ]]; then
            echo 'refault.label file-cache refaults'
            echo 'refault.type DERIVE'
            echo 'refault.min 0'
            echo 'refault.draw LINE2'
            echo "refault.info Pages evicted from the page cache and later reread (memory.stat ${refault_field})."
        fi
        if [[ $have_majfault -eq 1 ]]; then
            echo 'majflt.label major page faults'
            echo 'majflt.type DERIVE'
            echo 'majflt.min 0'
            echo 'majflt.draw LINE2'
            echo 'majflt.info Major page faults -- had to block on disk for a page (memory.stat pgmajfault). Includes cold first reads, so noisier than refaults as a thrash signal.'
        fi
    fi
} ; exit 0 ; fi

awk -v have_swap="$have_swap" -v swap_current="$swap_current" \
    -v rf="$refault_field" -v have_majf="$have_majfault" -v emit_ws="$emit_ws" '
    /^anon /             { anon      = $2 }
    /^file /             { file      = $2 }
    /^shmem /            { shmem     = $2 }
    /^kernel /           { kernel    = $2 }
    /^kernel_stack /     { kstack    = $2 }
    /^pagetables /       { ptables   = $2 }
    /^slab_reclaimable / { slab_rec  = $2 }
    /^slab_unreclaimable / { slab_unrec = $2 }
    $1 == rf             { refault   = $2 }   # rf empty -> never matches (fields are non-empty)
    /^pgmajfault /       { majf      = $2 }
    END {
        if (kernel == "") kernel = kstack + ptables + slab_rec + slab_unrec
        print "multigraph memory"
        printf "anon.value %s\n",   anon
        printf "cache.value %s\n",  file - shmem
        printf "shmem.value %s\n",  shmem
        printf "kernel.value %s\n", kernel
        if (have_swap) printf "swap.value %s\n", swap_current
        if (emit_ws) {
            print "multigraph memory_workingset"
            if (rf != "")  printf "refault.value %s\n", refault
            if (have_majf) printf "majflt.value %s\n",  majf
        }
    }
' "$MEM_STAT"
