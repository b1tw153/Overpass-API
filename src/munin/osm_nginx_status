#!/usr/bin/env bash
#
# Munin plugin: Overpass nginx connection status, from the stub_status endpoint.
#
# Multigraphs:
#   osm_nginx_status_connections  current connections by state (reading /
#                                 writing / waiting), stacked
#   osm_nginx_status_rate         accepted vs dropped connections per minute
#
# Reads nginx's stub_status page (the /nginx-status location in
# nginx.conf.template) with one curl per run -- no log scan, no state file. The
# connection states are instantaneous GAUGEs; accepts/handled are cumulative
# counters emitted as DERIVE so the master computes the rate. "dropped" is
# accepts minus handled: connections nginx accepted but could not handle because
# worker_connections was exhausted -- a failure that never appears in the access
# log, so this plugin is the only place it is visible.
#
# This file is a plugin (executable, symlinked into /etc/munin/plugins). The
# status URL defaults to the container endpoint; override in
# /etc/munin/plugin-conf.d for bare-metal, e.g.:
#   [osm_nginx_status]
#   env.NGINX_STATUS_URL http://127.0.0.1:8080/nginx-status

URL="${NGINX_STATUS_URL:-http://127.0.0.1:8080/nginx-status}"

if [[ "$1" = "autoconf" ]]; then
  if curl -sf --max-time 5 "$URL" 2>/dev/null | grep -q "Active connections"; then
    echo yes
  else
    echo "no ($URL did not return nginx stub_status; set env.NGINX_STATUS_URL)"
  fi
  exit 0
fi

if [[ "$1" = "config" ]]; then
  cat <<'CONFIG'
multigraph osm_nginx_status_connections
graph_title Overpass nginx connections
graph_vlabel connections
graph_info Current client connections by state, from nginx stub_status. The stack height equals nginx's Active connections; compare it against worker_connections for saturation headroom. "reading" is receiving the request, "writing" is sending the response (where long Overpass results sit), "waiting" is idle keep-alive.
reading.label reading
reading.type GAUGE
reading.draw AREASTACK
writing.label writing
writing.type GAUGE
writing.draw AREASTACK
waiting.label waiting (keep-alive)
waiting.type GAUGE
waiting.draw AREASTACK

multigraph osm_nginx_status_rate
graph_title Overpass nginx connection rate
graph_vlabel connections per minute
graph_info New connections accepted per minute, and connections dropped before being handled (accepts minus handled). A nonzero dropped rate means nginx hit worker_connections and refused connections -- a failure invisible in the access log.
accepts.label accepted
accepts.type DERIVE
accepts.min 0
accepts.cdef accepts,60,*
accepts.draw LINE2
dropped.label dropped
dropped.type DERIVE
dropped.min 0
dropped.cdef dropped,60,*
dropped.draw LINE2
CONFIG
  exit 0
fi

# ---- fetch ----

# A failed curl yields empty input; the awk then emits "U" (unknown) for every
# field so the master records a gap rather than the plugin erroring out.
STATUS=$(curl -sf --max-time 5 "$URL" 2>/dev/null)

printf '%s\n' "$STATUS" | awk '
  # "server accepts handled requests" is followed by a line of exactly three
  # integers; match on shape so the header line itself is skipped.
  NF == 3 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
    accepts = $1; handled = $2
  }
  /^Reading:/ { reading = $2; writing = $4; waiting = $6 }
  END {
    print "multigraph osm_nginx_status_connections"
    printf "reading.value %s\n", reading == "" ? "U" : reading
    printf "writing.value %s\n", writing == "" ? "U" : writing
    printf "waiting.value %s\n", waiting == "" ? "U" : waiting

    print "multigraph osm_nginx_status_rate"
    printf "accepts.value %s\n", accepts == "" ? "U" : accepts
    if (accepts == "" || handled == "")
      print "dropped.value U"
    else
      printf "dropped.value %d\n", accepts - handled
  }
'
