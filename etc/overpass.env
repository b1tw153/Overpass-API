# Overpass API Environment Variables
#
# This file documents all environment variables that can be used to configure
# Overpass API. Copy and edit this file to set up your environment, or source
# it from your shell or container environment. This file is compatible with
# docker's --env-file input.

# ==============================================================================
# GLOBAL SETTINGS
# ==============================================================================

# Path to the Overpass database directory
# NOTE FOR CONTAINER USERS: Mount this directory to /opt/overpass/db but leave
# the environment variable unset
#OVERPASS_DB_DIR=

# Path to the directory used to store diff files
# NOTE FOR CONTAINER USERS: Mount this directory to /opt/overpass/diff but leave
# the environment variable unset
#OVERPASS_DIFF_DIR=

# URL of the replication source
# Examples:
#   https://planet.openstreetmap.org/replication/minute
#   https://planet.openstreetmap.org/replication/hour
#   https://download.geofabrik.de/north-america/us/us-virgin-islands-updates
OVERPASS_DIFF_URL=

# Metadata mode: no|yes|attic (must match the imported database)
#   no:    base data only
#   yes:   include meta data (user, timestamp, changeset)
#   attic: include full history (requires more disk space)
OVERPASS_META_MODE=

# Starting replicate ID for replication
#   auto:  read from OVERPASS_DB_DIR/replicate_id
#   N:     start from sequence number N
OVERPASS_REPLICATE_ID=auto

# Enable area support: yes|no
OVERPASS_AREAS=

# Minimum free disk space threshold (default: 5)
# Used as a safeguard against disk-full conditions that can corrupt the database.
#
# For the database and diff filesystems, updates and downloads halt when free
# space falls below this percentage of the total filesystem capacity.
#
# For the backup filesystem, this percentage is added as headroom to the
# estimated space needed: (db_size - backup_size + largest_db_file) * (1 + N/100).
# If the estimate is not met, the backup is skipped.
#
# For the log filesystem (if OVERPASS_LOG_DIR is set), Overpass shuts down when
# free space falls below this percentage.
#OVERPASS_MIN_FREE_DISK_PERCENT=5

# ==============================================================================
# UPDATE SETTINGS
# ==============================================================================

# Update interval in seconds (default: 60)
# Should match the replication source frequency.
# Used by: run_osm3s.sh, fetch_osc.sh, apply_osc_to_db.sh, fetch_osc_and_apply.sh
#OVERPASS_UPDATE_FREQUENCY=60

# ==============================================================================
# WEB SERVER SETTINGS
# ==============================================================================

# Number of fcgiwrap worker processes (default: CPU_COUNT + 1)
# CPU_COUNT is read from the cgroup cpu.max quota when available (correct under
# Kubernetes CPU limits), otherwise from nproc. The +1 allows one worker to
# start immediately when another finishes, capturing turnaround slack without
# overcommitting memory or I/O. Increase toward 2 * CPU_COUNT only if CPU is
# the sole bottleneck and you have confirmed headroom on memory and I/O.
# NOTE: Only applies in the container environment.
#FCGIWRAP_WORKERS=

# Number of requests to queue beyond FCGIWRAP_WORKERS before returning 429
# (default: 2 * CPU_COUNT, same CPU_COUNT as above)
# When 0, requests beyond FCGIWRAP_WORKERS receive an immediate 429 response.
# When set, up to this many additional requests are held in nginx waiting for
# a worker to become free. Queued requests either get served or time out with
# 504 after NGINX_FASTCGI_TIMEOUT seconds. Reduce for lower tail latency at
# the cost of more 429 responses; increase if clients handle latency better
# than errors.
# NOTE: Only applies in the container environment.
#NGINX_CONNECTION_QUEUE=

# Maximum time in seconds nginx will wait for a query response (default: 300)
# Sets a server-side ceiling on query duration regardless of the client's
# [timeout:X] setting in the query. Lower values protect capacity on public
# servers; higher values allow long-running queries on private instances.
# NOTE: Only applies in the container environment.
#NGINX_FASTCGI_TIMEOUT=300

# Maximum concurrent connections per client IP (default: unset = no per-client limit)
# Limits how many simultaneous requests a single client IP can hold in nginx,
# counting both active (queued for a worker) and queued connections. Clients
# exceeding this limit receive an immediate 429 response.
# NOTE: Only applies in the container environment.
#NGINX_CLIENT_CONN_LIMIT=

# Maximum request rate per client IP (default: unset = no per-client rate limit)
# Format: Xr/s (requests per second) or Xr/m (requests per minute). When set,
# requests exceeding the rate are rejected with 429, subject to NGINX_CLIENT_REQ_BURST
# and NGINX_CLIENT_REQ_DELAY.
# NOTE: Only applies in the container environment.
#NGINX_CLIENT_REQ_RATE=

# Number of requests above NGINX_CLIENT_REQ_RATE to allow before rejecting (default: 0)
# Excess requests within the burst are delayed to drain at the configured rate,
# unless NGINX_CLIENT_REQ_DELAY raises the immediate-pass threshold.
# NOTE: Only applies in the container environment.
#NGINX_CLIENT_REQ_BURST=0

# Number of burst requests to pass through immediately before delaying (default: NGINX_CLIENT_REQ_BURST)
# 0 means delay all burst requests. Equal to NGINX_CLIENT_REQ_BURST means pass all
# burst requests immediately (equivalent to nginx nodelay).
# NOTE: Only applies in the container environment.
#NGINX_CLIENT_REQ_DELAY=

# ==============================================================================
# DISPATCHER SETTINGS
# ==============================================================================

# Directory for dispatcher socket files (default: OVERPASS_DB_DIR)
#OVERPASS_SOCKET_DIR=

# "Memory" pool size for the base dispatcher in bytes (default: 12884901888 = 12 GiB
# on bare metal, 768 GiB in the container build). This is a concurrency control. Set
# it only after reading the source code to understand query shedding.
#DISPATCHER_BASE_SPACE=

# "Memory" pool size for the areas dispatcher in bytes (default: DISPATCHER_BASE_SPACE)
# When unset, the areas dispatcher uses the same value as the base dispatcher.
# Note that this intentionally differs from the hard-coded default of 4294967296.
# This is a concurrency control. Set it only after reading the source code to
# understand query shedding.
#DISPATCHER_AREAS_SPACE=

# "Time" pool size for the base dispatcher in seconds (default: 262144 seconds)
# This is a concurrency control. Set it only after reading the source code to
# understand query shedding.
#DISPATCHER_BASE_TIME=

# "Time" pool size for the areas dispatcher in seconds (default: DISPATCHER_BASE_TIME)
# When unset, the areas dispatcher uses the same value as the base dispatcher.
# This is a concurrency control. Set it only after reading the source code to
# understand query shedding.
#DISPATCHER_AREAS_TIME=

# Deprecated: use DISPATCHER_BASE_TIME instead
#DISPATCHER_TIME=

# Maximum queries per time period; 0 means unlimited (default: 0)
#DISPATCHER_RATE_LIMIT=0

# Allow duplicate queries: yes|no (default: yes)
#DISPATCHER_ALLOW_DUPLICATE_QUERIES=yes

# Apply rate limit to local queries: yes|no (default: no)
#DISPATCHER_LIMIT_CLIENT_ZERO=no

# Stall detection threshold as a multiple of OVERPASS_UPDATE_FREQUENCY
#OVERPASS_STALL_MULTIPLIER=

# Diff cleanup frequency as a multiple of OVERPASS_UPDATE_FREQUENCY (default: 1440)
#OVERPASS_CLEANUP_MULTIPLIER=1440

# ==============================================================================
# BACKUP SETTINGS
# ==============================================================================

# Target directory for backup files
# NOTE FOR CONTAINER USERS: Mount this directory to /opt/overpass/backup but
# leave the environment variable unset
#OVERPASS_BACKUP_DIR=

# To run periodic backups, either OVERPASS_BACKUP_TIME or OVERPASS_BACKUP_DAY
# must be set. If neither OVERPASS_BACKUP_TIME nor OVERPASS_BACKUP_DAY is set,
# backup.sh runs once immediately and exits (one-shot mode).

# Time of day to run scheduled backup in HH:MM format (00:00-23:59)
# If only OVERPASS_BACKUP_DAY is set, defaults to 00:00.
# NOTE FOR CONTAINER USERS: The container time zone is UTC.
#OVERPASS_BACKUP_TIME=

# Day to run backup: MON|TUE|WED|THU|FRI|SAT|SUN or 1-31
# Optional. If not set, backup runs every day at OVERPASS_BACKUP_TIME.
#OVERPASS_BACKUP_DAY=

# Rsync timeout in seconds for backup and restore (default: 7200)
#OVERPASS_BACKUP_TIMEOUT=7200
#OVERPASS_RESTORE_TIMEOUT=7200

# ==============================================================================
# AREA UPDATE SETTINGS (rules_loop.sh)
# ==============================================================================

# Time of day to run area updates in HH:MM format (00:00-23:59)
# If not set, area updates run on every database change
# NOTE FOR CONTAINER USERS: The container time zone is UTC.
#AREA_UPDATE_TIME=

# Path to the area rules file (default: <database directory>/rules/areas.osm3s)
#AREA_RULES_FILE=

# ==============================================================================
# IMPORT SETTINGS (import_osm_data.sh)
# ==============================================================================

# URL of the planet or extract file to import
# Supported formats: .osm, .osm.bz2, .pbf, .osm.bz2.torrent, .pbf.torrent
#IMPORT_OSM_DATA_SOURCE=

# Compression method for imported data: no|gz|lz4 (default: lz4)
#IMPORT_OSM_COMPRESSION_METHOD=lz4

# ==============================================================================
# MUNIN MONITORING
# ==============================================================================
#
# Munin monitoring is opt-in and only applies in the container environment. The
# munin-node daemon ships in the image but does not run until you configure an
# access-control list with MUNIN_NODE_CIDR_ALLOW (see below). All other settings
# in this section only take effect once the node is enabled.
#
# The node listens on TCP 4949 (MUNIN_NODE_PORT) and is polled by a munin master
# every few minutes. You are responsible for publishing that port (e.g., docker
# -p) and for controlling network access to it; the access-control list below is
# a second layer of defense, not a substitute for firewalling the port.

# CIDR allow-list for the munin master, space-separated (e.g., "10.0.0.0/24
# 192.168.1.0/24"). Host bits must be zero, so use a network address
# (10.0.0.0/24) or a /32 host, not 10.0.0.5/24. The node binds IPv4 only (see
# MUNIN_NODE_HOST), so masters reach it over IPv4 and only IPv4 entries match.
# Setting this to a non-empty value is what STARTS munin-node; leaving it unset
# leaves the node stopped. A master is allowed to poll only if its source
# address matches an entry here. Use "0.0.0.0/0" to allow all hosts (only safe
# behind a firewall or on a private network).
#MUNIN_NODE_CIDR_ALLOW=

# CIDR deny-list, space-separated. Optional. Same host-bits-zero rule as the
# allow-list. Denies are evaluated before allows, so a deny inside an allowed
# range wins; use this to carve specific hosts out of a broader
# MUNIN_NODE_CIDR_ALLOW range.
#MUNIN_NODE_CIDR_DENY=

# Single IPv4 address the node binds to inside the container (default: 0.0.0.0,
# all interfaces). The only route in is the port you publish, so the default is
# usually right; set 127.0.0.1 for a master that shares the container's network
# namespace. IPv6 is not supported by the bundled munin-node.
#MUNIN_NODE_HOST=0.0.0.0

# TCP port the node listens on (default: 4949)
#MUNIN_NODE_PORT=4949

# Node name reported to the munin master (default: the container hostname)
# The master keys its stored history on this name. Set a stable value so that
# history is preserved across container restarts, which may change the hostname.
#MUNIN_NODE_HOST_NAME=

# munin-node log verbosity, higher is more verbose (default: 4)
#MUNIN_NODE_LOG_LEVEL=4

# ==============================================================================
# ADVANCED: fetch_osc.sh TUNING
# ==============================================================================
#
# The default values below are tuned for minutely replication. For hourly or
# daily replication, use one of the alternative groups instead.
#
# Minutely replication (default):
#   OVERPASS_UPDATE_FREQUENCY=60
#   FETCH_OSC_MAX_BATCH_SIZE=360
#   FETCH_OSC_RETRY_DELAY=15
#   FETCH_OSC_CONNECT_TIMEOUT=30
#   FETCH_OSC_KEEPALIVE_TIME=20
#   FETCH_OSC_SPEED_LIMIT=1024
#   FETCH_OSC_SPEED_TIME=30
#
# Maximum number of OSC files per batch download (default: 360)
#FETCH_OSC_MAX_BATCH_SIZE=360

# Maximum time span of a batch in seconds (default: 86400)
#FETCH_OSC_MAX_BATCH_TIME=86400

# Maximum download attempts per file (default: 20)
#FETCH_OSC_MAX_RETRIES=20

# Seconds between retry attempts (default: 15)
#FETCH_OSC_RETRY_DELAY=15

# Connection timeout in seconds (default: 30)
#FETCH_OSC_CONNECT_TIMEOUT=30

# Seconds to keep idle connections alive (default: 20)
#FETCH_OSC_KEEPALIVE_TIME=20

# Maximum parallel connections for batch downloads (default: 4)
#FETCH_OSC_PARALLEL_MAX=4

# Batch download mode: immediate|multiplexed (default: multiplexed)
#FETCH_OSC_PARALLEL_MODE=multiplexed

# Minimum download speed in bytes/sec; 0 to disable (default: 1024)
#FETCH_OSC_SPEED_LIMIT=1024

# Time in seconds to check minimum speed (default: 30)
#FETCH_OSC_SPEED_TIME=30

# ==============================================================================
# ADVANCED: apply_osc_to_db.sh TUNING
# ==============================================================================

# Maximum uncompressed size per batch in MB (default: 512)
#APPLY_OSC_MAX_BATCH_MB=512

# Maximum time span per batch in seconds (default: 86400)
#APPLY_OSC_MAX_BATCH_TIME=86400

# Maximum apply attempts per batch (default: 5; used by fetch_osc_and_apply.sh)
#APPLY_OSC_APPLY_MAX_RETRIES=5

# ==============================================================================
# ADVANCED: download_clone.sh TUNING
# ==============================================================================

# Number of parallel downloads (default: 3)
#DOWNLOAD_CLONE_PARALLEL_JOBS=3

# Total time limit for all downloads in seconds (default: 86400)
#DOWNLOAD_CLONE_MAX_TIME=86400

# Timeout for initial connection in seconds (default: 30)
#DOWNLOAD_CLONE_CONNECT_TIMEOUT=30

# Number of retries per file (default: 240)
#DOWNLOAD_CLONE_RETRY_COUNT=240

# Seconds between retries (default: 15)
#DOWNLOAD_CLONE_RETRY_DELAY=15

# Minimum bytes/sec before a download is considered stalled (default: 16)
#DOWNLOAD_CLONE_SPEED_LIMIT=16

# Seconds below speed limit before aborting (default: 60)
#DOWNLOAD_CLONE_SPEED_TIME=60

# ==============================================================================
# ADVANCED: run_osm3s.sh TUNING
# ==============================================================================

# Directory containing web server logs (if run_osm3s.sh should rotate them)
# NOTE: This is set by default in the container environment and should not be
#       used elsewhere
#OVERPASS_LOG_DIR=
